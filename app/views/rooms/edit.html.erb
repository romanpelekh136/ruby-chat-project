<%= turbo_frame_tag @room do %>
  <%= form_with model: @room, class: "edit-room-form" do |f| %>
    <%= f.text_field :name, required: true, autofocus: true, autocomplete: "off" %>
    <%= f.submit "Save", class: "btn" %>
    <%= link_to "Cancel", rooms_path, class: "btn", data: { turbo_frame: "_top" } %>
  <% end %>
<% end %>