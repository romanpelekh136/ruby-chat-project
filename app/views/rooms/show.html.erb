<h1><%= @room.name %></h1>

<%= turbo_stream_from @room %>

<div id="messages">
  <% @messages.each do |message| %>
    <%= render message %>
  <% end %>
</div>

<%= form_with model: [@room, @message], id: "new_message_form" do |f| %>
  <%= f.text_field :body, autofocus: true , placeholder: "Write new message..." %>
  <%= f.submit "Send" %>
<% end %>
  
