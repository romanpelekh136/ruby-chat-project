<%= turbo_frame_tag dom_id(room) do %>
  <div style="display: flex; justify-content: space-between; align-items: center; width: auto;">
    <% if room.persisted? %>
      <%= link_to room.name, room_path(room), data: { turbo_frame: "_top" } %>
      
      <details class="dropdown" data-controller="author-visibility" data-author-visibility-author-id-value="<%= room.user_id %>" style="display: none;">
        <summary class="dots-btn">...</summary>
          <div class="dropdown-menu">
              <%= link_to "Change Name", edit_room_path(room) %>
              <%= button_to "Delete", room_path(room), method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }%>
            </div>
      </details>
    <% else %>
      <%= room.name %>
    <% end %>
  </div>
<% end %>